# По умолчанию используется локальный SQLite (chtivo_shop.db), .env не обязателен.
# Когда переходим на PostgreSQL — раскомментировать и подставить свои данные:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/chtivo_shop

# Логин в /admin. Значения по умолчанию (admin / chtivo-admin) годятся только
# для локальной разработки — на реальном сервере обязательно переопределить.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=chtivo-admin
# Ключ для подписи сессии админки — на реальном сервере сгенерировать случайную строку
# (например: python -c "import secrets; print(secrets.token_hex(32))")
ADMIN_SECRET_KEY=dev-insecure-secret-change-me-in-.env

# Токен бота (от @BotFather) — нужен, чтобы backend мог проверить подпись
# initData от Mini App (см. app/telegram_auth.py). Значение должно совпадать
# с BOT_TOKEN в bot/.env.
BOT_TOKEN=

# Внутренний приёмник уведомлений бота (см. bot/notify_server.py) — backend
# сообщает туда о каждой смене статуса заказа (app/notifications.py).
# Значения по умолчанию подходят, если бот и backend на одной машине.
BOT_NOTIFY_URL=http://127.0.0.1:8081/internal/order-status
# Общий секрет с BOT_NOTIFY_SECRET в bot/.env — пусто означает без проверки.
BOT_NOTIFY_SECRET=

# Домены, с которых Mini App (../miniapp) может обращаться к API (CORS),
# через запятую. Без этой переменной по умолчанию разрешён только локальный
# dev-сервер Vite (localhost:5173) — см. app/main.py. На реальном деплое —
# https-домен, на котором фактически хостится Mini App.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
