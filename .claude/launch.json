    },
    {
      "name": "miniapp",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "cd miniapp; npm run dev"
      ],
      "port": 5173,
      "autoPort": true
    }
  ]
}
