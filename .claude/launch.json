{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "cd backend; .\\.venv\\Scripts\\python.exe run_dev.py"
      ],
      "port": 8000,
