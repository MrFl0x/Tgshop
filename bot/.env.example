# Токен бота от @BotFather — должен совпадать с BOT_TOKEN в backend/.env
# (backend им же проверяет подпись initData, см. backend/app/telegram_auth.py).
BOT_TOKEN=

# URL Mini App (ТЗ-2, ещё не собран). На реальном сервере — обязательно
# https, Telegram не откроет web_app-кнопку на http. Для локальной проверки
# самого бота можно оставить заглушку — кнопка появится в чате, но не
# откроется, пока здесь не будет настоящий https-адрес.
MINIAPP_URL=https://example.com/miniapp

# Внутренний HTTP-приёмник уведомлений о смене статуса заказа — backend
# стучится сюда (см. backend/app/notifications.py). Значения по умолчанию
# подходят, если бот и backend работают на одной машине.
BOT_NOTIFY_HOST=127.0.0.1
BOT_NOTIFY_PORT=8081
# Общий секрет с BOT_NOTIFY_SECRET в backend/.env — пусто означает "доверять
# любому, кто достучится до 127.0.0.1:8081" (нормально для локальной
# разработки, обязательно задать перед реальным сервером).
BOT_NOTIFY_SECRET=
